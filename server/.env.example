# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb://127.0.0.1:27017/evorahome

# Secret used to sign session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of storefront origins allowed to send credentials.
CLIENT_ORIGINS=http://localhost:5173

PORT=5000
NODE_ENV=development

# Optional. Without these the admin cannot upload images and must use files
# dropped into client/public/products/ instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used once by `npm run seed` to create the first admin account.
ADMIN_PHONE=0540870382
ADMIN_PASSWORD=
